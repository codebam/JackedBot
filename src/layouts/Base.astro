---
// Shared shell: Telegram Mini App host script, theme, viewport, one stylesheet.
import { env } from 'cloudflare:workers';
import { resolveOrigin } from '../lib/config.ts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Anything the page wants to expose to the islands without a second fetch. */
  boot?: Record<string, unknown>;
}

const { title = 'JackedBot · Play-money blackjack', description = 'Multiplayer blackjack with Telegram Stars buy-ins and play money only.' } = Astro.props;
const boot = Astro.props.boot ?? {};

// og:* has to carry absolute URLs, and the two "absolute origins" available here
// disagree. `resolveOrigin()` (src/lib/config.ts) prefers PUBLIC_ORIGIN, which
// wrangler.toml pins to the production worker: right for a canonical og:url, wrong
// for og:image on a preview/staging deployment, where the card has to show the
// image the host actually serving this page is serving. So the image follows the
// request and the URL follows the config, and both fall back to the request origin.
// This replaces a hardcoded https://jackedbot.codebam.workers.dev/og-image.png,
// which 404'd into a broken card on every non-production hostname.
const requestOrigin = Astro.url.origin.replace(/\/+$/, '');
const canonicalOrigin = (resolveOrigin(env as unknown as Env, Astro.request.url) || requestOrigin).replace(/\/+$/, '');
const ogImage = `${requestOrigin}/og-image.png`;
const ogUrl = `${canonicalOrigin}${Astro.url.pathname}`;
---

<!doctype html>
<html lang="en" data-theme="felt">
  <head>
    <meta charset="utf-8" />
    <!-- No `maximum-scale` and no `user-scalable=no`. `maximum-scale=1` blocked
         pinch-zoom outright in Android's WebView (iOS 10+ ignores it), which is a
         WCAG 1.4.4 Resize Text failure, and the only thing it was buying — killing
         the 300ms double-tap-to-zoom delay on the bet buttons — is what
         `touch-action: manipulation` on `.btn` now does properly, without taking
         zoom away from a low-vision player. `viewport-fit=cover` stays: it is what
         makes env(safe-area-inset-*) non-zero, and global.css reads that directly,
         so the notch and the home bar are respected before any island hydrates. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Deliberately dark, and deliberately NOT following tgWebAppTheme.
         Telegram hands a light-theme host a light bg_color, but every surface in
         this app is a hardcoded rgba white/black wash over the felt gradient and
         the card faces are near-white (#fffdf7) — following the host theme would
         need a second full palette the app does not have, and would produce
         white-on-white cards. The felt IS the product, so the shell pins the host
         chrome to it instead. This hex is `--felt-1`, and GameTable.tsx passes the
         same value to readyTelegramUi({ bgColor }) so the Telegram background
         behind the webview matches. `color-scheme: dark` is repeated in CSS, keyed
         on data-theme, so form controls, scrollbars and the UA canvas still follow
         if this meta is stripped — that is also what makes data-theme="felt"
         load-bearing rather than a dead attribute. -->
    <meta name="theme-color" content="#0c1f17" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <!-- The felt is dense with $ amounts, round numbers and shoe counts; stop iOS
         turning "round #12 · shoe 156/312" into tappable phone-number links. -->
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>
    <!-- Icons generated by scripts/gen-assets.mjs (wan2.7-image art + SVG emblem). -->
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="JackedBot" />
    <!-- Telegram renders this card for t.me links shared outside the Mini App. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JackedBot" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="JackedBot: multiplayer blackjack on a green felt table, play money only." />
    <meta property="og:locale" content="en_US" />
    <!-- Non-Telegram previews (X, Discord, iMessage) only read the twitter:* set;
         summary_large_image is what makes the 1200x630 art render full-bleed. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Telegram's host bridge. Must load before our islands so `window.Telegram`
         exists on first render; it is a plain script, not a module, by design. -->
    <script is:inline src="https://telegram.org/js/telegram-web-app.js"></script>
    <!-- Server-rendered bootstrap for the islands. `set:html` + `is:inline` is the
         Astro-sanctioned way to emit an inline script; `<` is escaped so the JSON can
         never break out of the script context. -->
    {Object.keys(boot).length > 0 && <script is:inline set:html={`window.__JACKEDBOT__=${JSON.stringify(boot).replace(/</g, '\\u003c')};`} />}
    <noscript>
      <!-- Every island is `client:load`, so with scripting off SessionGate renders
           its phase='checking' notice and never resolves it, and /table/[id] shows a
           felt whose socket never opens. Under <noscript> no client-side .alert can
           ever be created, which makes every .alert in the server-rendered HTML one
           of those unresolvable session notices — so hide them and say the true
           thing once, in the body below. (If a page ever server-renders a real
           .alert, this rule needs narrowing.) -->
      <style>
        .alert {
          display: none;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#jb-main">Skip to the table</a>
    <!-- tabindex="-1" so the skip link can actually move focus: a plain div is not
         focusable, and without it the link scrolls but leaves focus on the link.
         No page owns this id, so it lives in the shell and needs no page edits. -->
    <div id="jb-main" tabindex="-1">
      <noscript>
        <p class="noscript-note">
          JackedBot is a Telegram Mini App: signing in, the live table and the Stars buy-in all run in
          the browser. The table links on this page still work, but nothing that needs your Telegram
          session does. Open it from <b>@JackedBot</b> in Telegram with JavaScript enabled to play.
        </p>
      </noscript>
      <slot />
    </div>
  </body>
</html>
