---
// Shared shell: Telegram Mini App host script, theme, viewport, one stylesheet.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Anything the page wants to expose to the islands without a second fetch. */
  boot?: Record<string, unknown>;
}

const { title = 'JackedBot · Play-money blackjack', description = 'Multiplayer blackjack with Telegram Stars buy-ins and play money only.' } = Astro.props;
const boot = Astro.props.boot ?? {};
---

<!doctype html>
<html lang="en" data-theme="felt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1" />
    <meta name="theme-color" content="#0c1f17" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <!-- Icons generated by scripts/gen-assets.mjs (wan2.7-image art + SVG emblem). -->
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="JackedBot" />
    <!-- Telegram renders this card for t.me links shared outside the Mini App. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://jackedbot.codebam.workers.dev/og-image.png" />
    <!-- Telegram's host bridge. Must load before our islands so `window.Telegram`
         exists on first render; it is a plain script, not a module, by design. -->
    <script is:inline src="https://telegram.org/js/telegram-web-app.js"></script>
    <!-- Server-rendered bootstrap for the islands. `set:html` + `is:inline` is the
         Astro-sanctioned way to emit an inline script; `<` is escaped so the JSON can
         never break out of the script context. -->
    {Object.keys(boot).length > 0 && <script is:inline set:html={`window.__JACKEDBOT__=${JSON.stringify(boot).replace(/</g, '\\u003c')};`} />}
  </head>
  <body>
    <slot />
  </body>
</html>
