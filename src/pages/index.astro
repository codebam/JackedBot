---
// / — the lobby. Rendered on the edge from D1 (no Durable Object is woken to draw
// this page), then hydrated with two islands: the age gate and the wallet.
import Base from '../layouts/Base.astro';
import { SessionGate } from '../components/SessionGate.tsx';
import { WalletBar } from '../components/WalletBar.tsx';
import { PrivateTables } from '../components/PrivateTables.tsx';
import { env } from 'cloudflare:workers';
import { getConfig, resolveOrigin } from '../lib/config.ts';
import { normalizeInitData } from '../lib/auth.ts';
import { validateInitData } from '../lib/telegram/initData.ts';
import { bootstrapUser } from '../lib/telegram/session.ts';
import { ensureDefaultTables, listLobbyTables } from '../lib/db/tablesRepo.ts';
import { formatCents } from '../shared/money.ts';
import type { LobbyTable, Phase } from '../shared/protocol.ts';

const cfg = getConfig(env as unknown as Env, Astro.request.url);

// Server-side identity is optional on this route: an unauthenticated visitor gets a
// preview lobby, and every privileged action still requires verified initData.
const rawInit = normalizeInitData(Astro.url.searchParams.get('tgWebAppData') ?? (Astro.request.headers.get('x-telegram-init-data') ?? ''));
let tables: LobbyTable[] = [];
let me: { userId: number; name: string; bankrollCents: number; ageAccepted: boolean; welcomeGranted: boolean } | null = null;

try {
  const check = rawInit ? await validateInitData(rawInit, { botToken: cfg.botToken, maxAgeSeconds: cfg.initDataMaxAgeSeconds }) : null;
  if (check?.ok) {
    const boot = await bootstrapUser(env as unknown as Env, cfg, check.data.user);
    me = {
      userId: boot.user.telegram_user_id,
      name: boot.user.username ? `@${boot.user.username}` : boot.user.first_name ?? 'player',
      bankrollCents: boot.bankrollCents,
      ageAccepted: boot.ageAccepted,
      welcomeGranted: boot.welcomeGranted,
    };
    // Own/private felt comes from membership, never from the public listing - a
    // stranger browsing the lobby must not see someone's game night.
  } else {
    // No notice here. authNote was dead since 5f6e07b, and every string it built told
    // people already inside Telegram to open the page inside Telegram, because SSR
    // cannot see initData. SessionGate owns that state.
  }
  await ensureDefaultTables(env.DB);
  tables = await listLobbyTables(env.DB);
} catch (e) {
  // Logged, not rendered. There is no SSR-authored banner on this page any more
  // (see 5f6e07b): SessionGate reports what the client actually knows, and a
  // server-side "open inside Telegram" line was always a lie to real players.
  console.error('lobby SSR preview failed', (e as Error).message);
}

/**
 * Player-facing words for the felt's phase enum. `t.phase.toLowerCase()` used to
 * reach the screen verbatim, so a card read "player_turns" - an underscored
 * machine token where a person expects "Players acting".
 */
const PHASE_LABEL: Record<Phase, string> = {
  BETTING: 'Betting open',
  DEALING: 'Dealing',
  PLAYER_TURNS: 'Players acting',
  DEALER_TURN: 'Dealer acting',
  SETTLEMENT: 'Paying out',
  IDLE: 'Waiting',
};

const starsLabel = formatCents(cfg.centsPerStar);
// Handed to the islands so the very first client render already has a session to
// offer, instead of waiting on a round trip to /api/session.
const boot: Record<string, unknown> = { initData: rawInit || undefined, me, origin: resolveOrigin(env as unknown as Env, Astro.request.url) };
---

<Base title="JackedBot · Lobby" boot={boot}>
  <main class="lobby">
    <header class="lobby__head">
      <div>
        <h1>Jacked<span>Bot</span></h1>
        <p class="lobby__sub">Multiplayer blackjack · play money only</p>
      </div>
      {
        /* Always rendered. This was gated on `me`, which is SSR identity - and SSR
           cannot see initData on a real Mini App launch (the same false negative
           behind ded99de, 25fa085 and 5c90559). So for actual players the lobby had
           no bankroll and no buy button at all, while "How the money works" below
           told them to "buy with the button above". The island fetches its own
           balance when SSR has nothing to hand it. */
        <WalletBar
          client:load
          initialBankrollCents={me ? me.bankrollCents : null}
          starsPerPurchase={cfg.buyIn.stars}
          centsPerStar={cfg.centsPerStar}
          purchaseNote={cfg.buyIn.description}
          compact
        />
      }
    </header>

    {
      /* SSR identity is a fast path only. This island always re-checks with the
         client's initData, so a Mini App whose URL carried no tgWebAppData still
         gets its age gate instead of dead-ending on "open in Telegram". */
      <SessionGate
        client:load
        serverResolved={Boolean(me)}
        serverAgeAccepted={me ? me.ageAccepted : undefined}
        houseWarning={cfg.houseWarning}
        starsLabel={starsLabel}
        pendingNotice={'Restoring your Telegram session\u2026'}
      />
    }

    {
      /* Neither the age-gate nudge nor the welcome-grant banner is rendered from
         `me` any more. Both are identity states, SSR cannot see identity, and both
         are now owned by the component that can: SessionGate puts the AgeGate up
         (covering this line entirely), and WalletBar announces the starter stack
         from the /api/session reply that actually reports it. */
    }

    <!-- Deliberately NOT rendered: see the SessionGate note above. This banner was
         keyed on SSR state alone, and SSR cannot see initData (Telegram passes it to
         the client object, not the URL), so it told authenticated players to open the
         app inside Telegram while the app was already inside Telegram. -->

    <section class="lobby__tables">
      <h2 class="lobby__h2">Open tables</h2>
      {
        tables.length === 0 ? (
          <p class="lobby__empty">
            No open tables right now. Create a private one below and invite your group — it takes about ten seconds.
          </p>
        ) : (
          <ul class="tcards">
            {tables.map((t) => (
              <li class={`tcard tcard--${t.phase}`} data-open={t.openSeats > 0}>
                <div class="tcard__top">
                  <h3>{t.name}</h3>
                  <span class={`tbadge tbadge--${t.status}`}>
                    {t.status === 'open' ? PHASE_LABEL[t.phase] : t.status === 'closing' ? 'Closing' : 'Closed'}
                  </span>
                </div>

                <div class="tcard__stats">
                  <div>
                    <span class="k">Seats</span>
                    <b>
                      {t.activeSeats}/{t.seatCount}
                    </b>
                  </div>
                  <div>
                    <span class="k">Stakes</span>
                    <b>
                      {formatCents(t.minBetCents)}–{formatCents(t.maxBetCents)}
                    </b>
                  </div>
                  <div>
                    <span class="k">Buy-in</span>
                    <b>{formatCents(t.buyInCents)}</b>
                  </div>
                  {
                    /* Not a "pot". Blackjack has no pot: preview.potCents is the sum of
                       every seat's committed wager on the hand in progress (tablesRepo
                       adds up snapshot.seats[].committedCents), and it is only rendered
                       while the dealer has an up card, i.e. while a hand is live. */
                    t.preview?.dealerUpCard !== null && t.preview?.dealerUpCard !== undefined ? (
                      <div>
                        <span class="k">In play</span>
                        <b>{formatCents(t.preview.potCents)}</b>
                      </div>
                    ) : null
                  }
                </div>

                {t.minBankrollCents > 0 && me && me.bankrollCents < t.minBankrollCents ? (
                  <p class="tcard__gate">Needs {formatCents(t.minBankrollCents)} on hand — you have {formatCents(me.bankrollCents)}.</p>
                ) : null}

                {
                  /* No aria-disabled here. A full table is still a real destination: the
                     Table DO keeps a balance warm for viewers without a seat and the felt
                     offers "Sit down" the moment a chair frees up, so the link works and
                     announces itself as enabled. aria-disabled on a live <a> lied in both
                     directions - screen readers said "dimmed" while a tap still navigated. */
                  <a
                    class={t.openSeats > 0 ? 'btn btn--primary tcard__cta' : 'btn btn--ghost tcard__cta'}
                    href={`/table/${t.id}`}
                  >
                    {t.openSeats > 0 ? 'Join table' : 'Table full — watch the hand'}
                  </a>
                }
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <PrivateTables client:load />

    <section class="lobby__create">
      <a class="btn btn--gold btn--block" href="/new-table">Create a private table</a>
      <p class="lobby__fine">Your own bet limits, buy-in and seats. Invite people with @JackedBot in any group.</p>
    </section>

    <section class="lobby__how">
      <h2 class="lobby__h2">How the money works</h2>
      <ol class="lobby__steps">
        {
          /* Leads with the question a worried visitor actually has. "Chips are play
             money" is a statement about the chips; "you cannot lose real money" is
             the answer to the thing they were wondering. */
        }
        <li>
          <b>Can you lose real money? No.</b> The only thing that ever costs Stars is buying chips, and you choose that
          yourself. There is no cashout: chips cannot be transferred, sold, or turned into a prize — so the most you can
          lose is the Stars you already decided to spend.
        </li>
        <li>
          <b>1 ⭐ = {starsLabel} of chips.</b> Buy from the wallet at the top of this screen; Telegram handles the payment.
        </li>
        {
          /* Both of these are promises the server config decides whether it keeps:
             WELCOME_GRANT_CENTS and BUST_RELIEF_CENTS can each be 0, which turns
             them off. Stating them unconditionally would advertise free chips to a
             deployment that does not give any. */
          cfg.welcomeGrantCents > 0 ? (
            <li>
              <b>New here?</b> Your first visit adds a free <b>{formatCents(cfg.welcomeGrantCents)}</b> starter stack — no
              purchase and no card needed.
            </li>
          ) : null
        }
        {
          cfg.bustReliefCents > 0 ? (
            <li>
              <b>Out of chips?</b> Buy again, or just keep playing: busting to $0 credits you{' '}
              {formatCents(cfg.bustReliefCents)} of play money, so running out is never a paywall. Stacks add together
              across purchases.
            </li>
          ) : (
            <li>
              <b>Out of chips?</b> Buy again — stacks add together across purchases.
            </li>
          )
        }
      </ol>
      <p class="lobby__fine">{cfg.houseWarning}</p>
    </section>
  </main>
</Base>
